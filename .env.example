HOST=127.0.0.1
PORT=8010
APP_ENV=development

# Default mode is local and needs no network/API key.
# To enable an OpenAI-compatible chat-completions API, copy this file to .env
# and fill these values.
LLM_MODE=local
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=500
