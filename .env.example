HOST=127.0.0.1
PORT=8010
APP_ENV=development

# DeepSeek V4 is the preferred answer generator.
# Copy this file to .env and fill LLM_API_KEY locally.
# If the key is missing or the API fails, the backend falls back to the local knowledge base.
LLM_MODE=api
LLM_API_KEY=
LLM_API_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=500

# Optional: enable web search via Bocha AI.
# Create a Bocha API key at https://open.bochaai.com/ and fill it locally.
# Leave WEB_SEARCH_API_KEY empty to disable web search.
WEB_SEARCH_API_KEY=
WEB_SEARCH_API_BASE=https://api.bochaai.com/v1/web-search
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_MAX_RESULTS=3
